{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmdenaAI/ULog/schemas/cv/v0/computer_vision.schema.json",
  "title": "Computer Vision Contract v0",
  "description": "Normalized telemetry for CV phases with metrics, hardware, and provenance.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "phase": {
      "type": "string",
      "description": "Lifecycle phase emitting this event.",
      "enum": ["ingest", "preprocess", "inference", "postprocess", "eval", "serve", "track", "pose"]
    },

    "model_name": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "image_count": { "type": "integer", "minimum": 1 },

    "metrics": {
      "type": "object",
      "description": "Standardized metric set with extension bucket.",
      "properties": {
        "fps": { "type": "number", "minimum": 0 },
        "map": { "type": "number", "minimum": 0, "maximum": 1 },
        "ap": { "type": "number", "minimum": 0, "maximum": 1 },
        "ap50": { "type": "number", "minimum": 0, "maximum": 1 },
        "iou": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "loss": { "type": "number", "minimum": 0 },
        "extra": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false,
      "minProperties": 1
    },

    "latency_ms": { "type": "number", "minimum": 0 },
    "batch_size": { "type": "integer", "minimum": 1 },

    "hardware": {
      "description": "Hardware descriptor. Either a free-form string or a structured object.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accelerator": { "type": "string", "minLength": 1, "description": "e.g., NVIDIA A100, TPU v4, Apple M2" },
            "runtime": { "type": "string", "description": "e.g., TensorRT 10.0, ONNX Runtime 1.18, PyTorch 2.4" },
            "memory_gb": { "type": "number", "minimum": 0 },
            "component": { "type": "string", "description": "e.g., GPU, CPU, TPU, NPU" },
            "level": { "type": "string", "description": "Granularity (e.g., device, host, cluster)" }
          },
          "required": ["accelerator"]
        }
      ]
    },

    "meta": {
      "type": "object",
      "description": "Provenance for parsing and original source.",
      "additionalProperties": false,
      "properties": {
        "raw_message": { "type": "string" },
        "parse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parser_name": { "type": "string" },
            "parser_version": { "type": "string" },
            "pattern_id": { "type": "string" },
            "ok": { "type": "boolean" }
          },
          "required": ["parser_name", "parser_version", "pattern_id"]
        }
      },
      "required": ["raw_message", "parse"]
    },

    "level": { "$ref": "../../_common.json#/$defs/level" },
    "category": { "$ref": "../../_common.json#/$defs/category" },

    "outcome": { "$ref": "../../_common.json#/$defs/outcome" },

    "safety_flags": {
      "description": "Preferred: array of safety flags; Legacy: single flag string",
      "oneOf": [
        { "$ref": "../../_common.json#/$defs/safety_flag" },
        {
          "type": "array",
          "items": { "$ref": "../../_common.json#/$defs/safety_flag" },
          "maxItems": 10,
          "uniqueItems": true
        }
      ]
    },

    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["message"]
    },

    "timestamp": { "type": "string", "format": "date-time" },
    "component": { "type": "string", "minLength": 1 },

    "metadata": {
      "type": "object",
      "description": "Additional flexible metadata for unknown fields",
      "additionalProperties": true
    }
  },

  "required": [
    "phase",
    "model_name",
    "dataset_id",
    "image_count",
    "metrics",
    "latency_ms",
    "batch_size",
    "hardware",
    "outcome",
    "meta"
  ],

  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "failure" } }, "required": ["outcome"] },
      "then": { "required": ["error"] }
    }
  ]
}
