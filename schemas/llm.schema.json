{
  "$id": "https://ulog.ai/schemas/llm.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "type": "object",
  "title": "LLM Interaction Log",
  "description": "Schema for LLM interaction logs.",
  "required": ["log_id", "log_timestamp", "model", "outcome", "category", "prompt", "result", "level"],
  "properties": {
    "log_id": {
      "type": "string",
      "description": "Unique ID for log entry.",
      "format": "uuid"
    },
    "log_timestamp": {
      "type": "string",
      "description": "Timestamp when the log entry was created.",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "description": "Operation results: `success` or `failure`.",
      "enum": ["success", "failure"]
    },
    "model": {
      "type": "string",
      "description": "Name of LLM model used."
    },
    "category": {
      "type": "string",
      "description": "Event domains such as `auth`, `network`, `data`, `model`, etc.",
      "enum": ["auth", "network", "data", "model", "service", "system", "storage", "scheduler", "deployment", "security", "third_party"]
    },
    "prompt": {
      "type": "object",
      "description": "Input details sent to the LLM.",
      "properties": {
        "prompt_id": {
          "type": "string",
          "description": "Unique ID for the prompt.",
          "format": "uuid"
        },
        "input_tokens": {
          "type": "integer",
          "description": "Number of tokens in the prompt.",
          "minimum": 0
        },
        "prompt_text": {
          "type": "string",
          "description": "Prompt text sent to the LLM."
        },
        "parameters": {
          "type": "object",
          "description": "Model parameters requested by user for this prompt.",
          "properties": {
            "temperature": {
              "type": "number",
              "description": "Optional temperature tuning parameter.",
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "type": "number",
              "description": "Cumulative probability threshold parameter.",
              "minimum": 0,
              "maximum": 1
            },
            "max_tokens": {
              "type": "integer",
              "description": "Maximum tokens the model can generate."
            },
            "stop_sequences": {
              "type": "array",
              "description": "Custom stop sequences to end generation.",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["prompt_id", "input_tokens", "prompt_text"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "LLM response and output metadata.",
      "properties": {
        "result_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique ID for this response."
        },
        "response_text": {
          "type": "string",
          "description": "Full text of the LLM response."
        },
        "output_tokens": {
          "type": "integer",
          "description": "Number of output tokens generated by the model.",
          "minimum": 0
        },
        "anonymization_note": {
          "type": "string",
          "description": "Notes on how sensitive data has been anonymized."
        },
        "latency_ms": {
          "type": "integer",
          "description": "Total latency of the request in milliseconds.",
          "minimum": 0
        },
        "model_quality_flags": {
          "type": "string",
          "description": "Model quality issues."
        },
        "safety_flags": {
          "type": "string",
          "description": "Identifies sensitive or safety-related cases.",
          "enum": ["llm", "cv", "pii", "security"]
        }
      },
      "required": ["result_id", "response_text", "output_tokens", "latency_ms"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the log entry.",
      "properties": {
        "source": { "type": "string" },
        "ingestion_ts": { "type": "string", "format": "date-time" },
        "contract_version": { 
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer of the schema contract."
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "string",
      "description": "Component responsible for this log entry.",
      "enum": ["api", "agent", "pipeline"]
    },
    "level": {
      "type": "string",
      "description": "Severity of log entry.",
      "enum": ["info", "warn", "error"]
    },
    "usage": {
      "type": "object",
      "description": "Aggregated resource usage metrics.",
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "description": "Actual sampling parameters used.",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_k": { 
          "type": "integer",
          "minimum": 0,
          "description": "Limits sampling to the top K tokens."
        },
        "presence_penalty": { 
          "type": "number", 
          "description": "Penalty for new token presence.",
          "minimum": -2,
          "maximum": 2
        },
        "frequency_penalty": { 
          "type": "number", 
          "description": "Penalty based on token frequency.",
          "minimum": -2,
          "maximum": 2
        },
        "stop": { 
          "type": "string",
          "description": "Custom stop sequence to end generation."
        },
        "seed": { 
          "type": "integer",
          "description": "Optional seed for deterministic output."
        }     
      },
      "additionalProperties": false
    },
    "rag": {
      "type": "object",
      "description": "Retrieval-Augmented Generation details.",
      "properties": {
        "query": { "type": "string" },
        "citations": { "type": "string" },
        "stage": { 
          "type": "string",
          "enum": ["query", "retrieval", "generation"]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "description": "Aggregated performance metrics.",
      "properties": {
        "average_latency_ms": { "type": "number", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "error_log": {
      "type": "array",
      "description": "List of errors encountered during prompting or response generation.",
      "items": {
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Stable short codes for known error types."
          },
          "error_type": {
            "type": "string",
            "description": "Type of the error."
          },
          "message": {
            "type": "string",
            "description": "Detailed error message."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the error occurred."
          }
        },
        "required": ["error_code", "error_type", "message", "timestamp"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}