{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "LLM Interaction Log",
  "description": "Schema for LLM interaction logs.",
  "required": ["log_id", "log_timestamp", "model", "prompt", "result"],
  "properties": {
    "log_id": {
      "type": "string",
      "description": "Unique ID for log entry.",
      "format": "uuid"
    },
    "log_timestamp": {
      "type": "string",
      "description": "Timestamp when the log entry was created.",
      "format": "date-time"
    },
    "model": {
      "type": "string",
      "description": "Name of LLM model used."
    },
    "prompt": {
      "type": "object",
      "description": "Input details sent to the LLM.",
      "properties": {
        "prompt_id": {
          "type": "string",
          "description": "Unique ID for the prompt.",
          "format": "uuid"
        },
        "input_tokens": {
          "type": "integer",
          "description": "Number of tokens in the prompt.",
          "minimum": 0
        },
        "prompt_text": {
          "type": "string",
          "description": "Prompt text sent to the LLM."
        },
        "parameters": {
          "type": "object",
          "description": "Model parameters requested by user for this prompt.",
          "properties": {
            "temperature": {
              "type": "number",
              "description": "Optional temperature tuning parameter.",
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "type": "number",
              "description": "Cumulative probability threshold parameter.",
              "minimum": 0,
              "maximum": 1
            },
            "max_tokens": {
              "type": "integer",
              "description": "Maximum tokens the model can generate."
            },
            "stop_sequences": {
              "type": "array",
              "description": "Custom stop sequences to end generation.",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["prompt_id", "input_tokens", "prompt_text"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "LLM response and output metadata.",
      "properties": {
        "result_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique ID for this response."
        },
        "response_text": {
          "type": "string",
          "description": "Full text of the LLM response."
        },
        "output_tokens": {
          "type": "integer",
          "description": "Number of output tokens generated by the model.",
          "minimum": 0
        },
        "anonymization_note": {
          "type": "string",
          "description": "Notes on how sensitive data has been anonymized."
        },
        "latency_ms": {
          "type": "number",
          "description": "Total latency of the request in milliseconds.",
          "minimum": 0
        },
        "finish_reason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "content_filter",
            "tool_calls",
            "error",
            "timeout",
            "interrupted"
          ],
          "description": "Reason the generation stopped."
        },
        "model_quality_flags": {
          "type": "array",
          "description": "List of model quality issues (e.g., repetition, truncation, hallucination).",
          "items": {
            "type": "string"
          }
        },
        "safety_flags": {
          "type": "array",
          "description": "List of safety issues.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["result_id", "response_text", "output_tokens", "latency_ms"],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "description": "Metadata about the log entry.",
      "properties": {
        "model_version": { "type": "string" },
        "region": { "type": "string" }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "string",
      "description": "Component responsible for this log entry."
    },
    "level": {
      "type": "string",
      "description": "Severity of log entry.",
      "enum": ["info", "warning", "error", "debug"]
    },
    "usage": {
      "type": "object",
      "description": "Aggregated resource usage metrics.",
      "properties": {
        "total_cost_usd": { "type": "number", "minimum": 0, "description": "Estimated cost in USD." },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0, "description": "Sum of input and output tokens." }
      },
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "description": "Actual sampling parameters used.",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 }      
      },
      "additionalProperties": false
    },
    "rag": {
      "type": "object",
      "description": "Retrieval-Augmented Generation details.",
      "properties": {
        "source_documents": { "type": "array", "items": { "type": "string" } },
        "retrieval_time_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "description": "Aggregated performance metrics.",
      "properties": {
        "average_latency_ms": { "type": "number", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "error_log": {
      "type": "array",
      "description": "List of errors encountered during prompting or response generation.",
      "items": {
        "type": "object",
        "properties": {
          "error_type": {
            "type": "string",
            "description": "Type of the error."
          },
          "message": {
            "type": "string",
            "description": "Detailed error message."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the error occurred."
          }
        },
        "required": ["error_type", "message", "timestamp"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}