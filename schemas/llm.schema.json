{
  "$id": "https://ulog.ai/schemas/llm.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.1.1",
  "type": "object",
  "title": "LLM Interaction Log",
  "description": "Schema for LLM interaction logs.",
  "required": ["log_id", "log_timestamp", "model", "outcome", "category", "prompt", "result", "pipeline_stage"],
  "$defs": {
    "level": {
      "type": "string",
      "enum": ["info", "warn", "error"]
    },
    "category": {
      "type": "string",
      "enum": ["auth", "network", "data", "model", "service", "system", "storage", "scheduler", "deployment", "security", "third_party"]
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure"]
    },
    "safety_flag": {
      "type": "string",
      "enum": ["llm", "cv", "pii", "security", "toxicity", "hallucination", "bias"]
    }
  },
  "properties": {
    "log_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID for log entry."
    },
    "log_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the log entry was created."
    },
    "pipeline_stage": {
      "type": "string",
      "description": "High-level pipeline stage classification.",
      "enum": ["serve", "tokenizer", "quant", "load", "inference", "rag_retrieve", "rag_embed", "rag_rerank", "safety_check", "sampling"]
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "model": {
      "type": "string",
      "description": "Name of LLM model used."
    },
    "category": { "$ref": "#/$defs/category" },
    "prompt": {
      "type": "object",
      "description": "Input details sent to the LLM.",
      "properties": {
        "prompt_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_text": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_tokens": { "type": "integer" },
            "stop_sequences": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["prompt_id", "input_tokens", "prompt_text"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "LLM response and output metadata.",
      "properties": {
        "result_id": { "type": "string", "format": "uuid" },
        "response_text": { "type": "string" },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "anonymization_note": { "type": "string" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "ttft_ms": { "type": "integer", "minimum": 0 },
        "model_quality_flags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of model quality issues (e.g., repetition, truncation)."
        },
        "safety_flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_flag" },
          "description": "List of safety or sensitive case flags."
        }
      },
      "required": ["result_id", "response_text", "output_tokens", "latency_ms"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "ingestion_ts": { "type": "string", "format": "date-time" },
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "description": "Additional meta information for parsing and provenance.",
      "properties": {
        "raw_message": {
          "type": "string",
          "description": "Redacted or summarized original message text."
        },
        "parse": {
          "type": "object",
          "properties": {
            "adapter": { "type": "string" },
            "adapter_version": { "type": "string" },
            "parse_ok": { "type": "boolean" },
            "notes": { "type": "string" }
          },
          "required": ["adapter", "adapter_version", "parse_ok"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "string",
      "enum": ["api", "agent", "pipeline"]
    },
    "level": { "$ref": "#/$defs/level" },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_k": { "type": "integer", "minimum": 0 },
        "presence_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
        "frequency_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
        "stop_sequences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "seed": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "rag": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "citations": { "type": "string" },
        "stage": {
          "type": "string",
          "enum": ["query", "retrieval", "generation"]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "average_latency_ms": { "type": "number", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "endpoint": {
          "type": "string",
          "description": "Optional endpoint name or path for request."
        },
        "extra": {
          "type": "object",
          "description": "Flexible metrics container (e.g., p50_ms, p95_ms).",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "error_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error_code": { "type": "string" },
          "error_type": { "type": "string" },
          "message": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["error_code", "error_type", "message", "timestamp"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
