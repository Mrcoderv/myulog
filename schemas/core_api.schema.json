{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Core API Event",
  "description": "Minimal schema for API request/response/error logging.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when the event occurred.",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "description": "Unique identifier for the request (for tracing across services).",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "description": "Name of the service emitting this log.",
      "minLength": 1,
      "maxLength": 100
    },
    "endpoint": {
      "type": "string",
      "description": "API endpoint or route that was called.",
      "pattern": "^/.*$",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "description": "HTTP method or operation type.",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS",
        "INTERNAL"
      ]
    },
    "result": {
      "type": "string",
      "description": "Outcome of the request.",
      "enum": ["success", "error", "timeout", "rejected", "throttled"]
    },
    "latency_ms": {
      "type": "number",
      "description": "Request latency in milliseconds (non-negative).",
      "minimum": 0
    },
    "env": {
      "type": "string",
      "description": "Environment where event occurred.",
      "enum": ["production", "staging", "development", "test"]
    },
    "http_status": {
      "type": "integer",
      "description": "HTTP status code (optional).",
      "minimum": 100,
      "maximum": 599
    },
    "error": {
      "type": "object",
      "description": "Error details when result is 'error', 'timeout', or 'rejected'.",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Application-specific error code.",
          "minLength": 1,
          "examples": ["AUTH_INVALID_CREDENTIALS", "DB_CONNECTION_FAILED"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": ["code", "message"]
    },
    "metadata": {
      "type": "object",
      "description": "Optional additional context (client_id, region, upstream_services, etc.).",
      "additionalProperties": true
    }
  },
  "required": [
    "timestamp",
    "request_id",
    "service",
    "endpoint",
    "action",
    "result",
    "latency_ms",
    "env"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": ["error", "timeout", "rejected"]
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}
