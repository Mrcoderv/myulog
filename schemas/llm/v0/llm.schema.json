{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmdenaAI/ULog/schemas/llm/v0/llm.schema.json",
  "title": "LLM Interaction Event Schema v0",
  "description": "Normalized LLM interaction events with provenance, pipeline stages, usage metrics, sampler params, and ms-based timings.",
  "type": "object",
  "additionalProperties": false,

  "required": ["meta", "timestamp", "outcome", "request_id", "model", "pipeline_stage"],

  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_message"],
      "properties": {
        "raw_message": { "type": "string", "maxLength": 10000 },
        "parse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parser_name", "parser_version"],
          "properties": {
            "parser_name":    { "type": "string", "minLength": 1 },
            "parser_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "pattern_id":     { "type": "string", "minLength": 1 },
            "confidence":     { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "outcome":    { "$ref": "../../_common.json#/$defs/outcome" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_preview":     { "type": "string",  "maxLength": 256, "description": "Short preview; never store full prompts/outputs." },
        "output_text_length": { "type": "integer", "minimum": 0 },
        "safety_flags":       { "type": "array", "items": { "$ref": "../../_common.json#/$defs/safety_flag" }, "maxItems": 10 },
        "model_quality_flags":{ "type": "array", "items": { "type": "string" }, "maxItems": 10 }
      }
    },
    "level":      { "$ref": "../../_common.json#/$defs/level" },
    "category":   { "$ref": "../../_common.json#/$defs/category" },
    "component":  { "type": "string", "maxLength": 64 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "ttft_ms":    { "type": "number", "minimum": 0 },
    "error": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {
            "type":    { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "stack":   { "type": "string" }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Additional flexible metadata for unknown fields",
      "additionalProperties": true
    },
    "request_id": { "type": "string", "minLength": 1 },
    "endpoint":   { "type": "string", "maxLength": 128 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "extra":  { "type": "object", "additionalProperties": { "type": ["number", "integer", "string", "boolean"] } }
      }
    },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "pipeline_stage": {
      "type": "string",
      "description": "LLM pipeline stage that produced this event.",
      "enum": [
        "serve",
        "tokenizer",
        "quant",
        "load",
        "inference",
        "rag_retrieve",
        "rag_embed",
        "rag_rerank",
        "safety_check",
        "sampling"
      ]
    },
    "finish_reason": {
      "type": "string",
      "description": "Why text generation stopped (OpenAI-style finish reasons).",
      "enum": ["stop", "length", "content_filter", "tool_calls", "timeout", "interrupted", "other"]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens":     { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens":      { "type": "integer", "minimum": 0 }
      }
    },
    "sampler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature":       { "type": "number", "minimum": 0 },
        "top_p":             { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "top_k":             { "type": "integer", "minimum": 1 },
        "max_tokens":        { "type": "integer", "minimum": 1 },
        "presence_penalty":  { "type": "number" },
        "frequency_penalty": { "type": "number" },
        "stop_sequences":    { "type": "array", "items": { "type": "string" } },
        "seed":              { "type": "integer" }
      }
    }
  },

  "allOf": [
    {
      "if":   { "properties": { "outcome": { "const": "success" } }, "required": ["outcome"] },
      "then": { "required": ["result"], "properties": { "result": { "required": ["output_text_length"] } } }
    },
    {
      "if":   { "properties": { "outcome": { "const": "failure" } }, "required": ["outcome"] },
      "then": { "required": ["error"] }
    }
  ]
}
