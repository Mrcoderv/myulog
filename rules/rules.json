{
  "rules_version": "v1.0.0",
  "aliases": {
    "@status": [
      "outcome",
      "status",
      "result"
    ],
    "@latency": [
      "latency_ms",
      "duration_ms",
      "ttft_ms"
    ],
    "@errorCode": [
      "http_status",
      "error.code",
      "response.status"
    ]
  },
  "default_action": {
    "level": "info",
    "category": "core_api",
    "outcome": "success",
    "tags": []
  },
  "rules": [
    {
      "rule_id": "api-5xx-critical",
      "version": "1.0.0",
      "name": "Critical 5xx server errors",
      "description": "Classify 5xx HTTP errors as critical service failures",
      "applies_to": [
        "core_api"
      ],
      "when": {
        "all": [
          {
            "field": "@errorCode",
            "op": "gte",
            "value": 500
          },
          {
            "field": "@errorCode",
            "op": "lt",
            "value": 600
          }
        ]
      },
      "then": {
        "level": "critical",
        "category": "core_api",
        "sub_category": "service",
        "outcome": "failure",
        "tags": [
          "core_api",
          "5xx"
        ]
      }
    },
    {
      "rule_id": "api-unauthorized",
      "version": "1.0.0",
      "name": "Authentication failures",
      "description": "Flag 401/403 unauthorized access attempts",
      "applies_to": [
        "core_api"
      ],
      "when": {
        "any": [
          {
            "field": "@errorCode",
            "op": "eq",
            "value": 401
          },
          {
            "field": "@errorCode",
            "op": "eq",
            "value": 403
          }
        ]
      },
      "then": {
        "level": "warn",
        "category": "core_api",
        "sub_category": "auth",
        "outcome": "failure",
        "tags": [
          "core_api",
          "auth"
        ]
      }
    },
    {
      "rule_id": "core-api-error-rate-high",
      "version": "1.0.0",
      "name": "High error rate detected",
      "description": "Extract % from raw message and flag if >= 10%",
      "applies_to": [
        "core_api"
      ],
      "when": {
        "all": [
          {
            "field": "meta.raw_message",
            "op": "extract_percent",
            "pattern": "([0-9]+)\\s*%",
            "compare": {
              "gte": 10
            }
          }
        ]
      },
      "then": {
        "level": "warn",
        "category": "core_api",
        "sub_category": "metrics",
        "outcome": "failure",
        "tags": [
          "core_api",
          "error_rate"
        ]
      }
    },
    {
      "rule_id": "llm-tokenizer-error",
      "version": "1.0.0",
      "name": "Tokenizer initialization errors",
      "description": "Flag tokenizer errors during model loading",
      "applies_to": [
        "llm"
      ],
      "when": {
        "all": [
          {
            "field": "pipeline_stage",
            "op": "eq",
            "value": "tokenizer"
          },
          {
            "field": "outcome",
            "op": "eq",
            "value": "failure"
          },
          {
            "field": "meta.raw_message",
            "op": "regex",
            "value": "(?i)(tokenizer|merges|vocab).*(error|fail|incompatible)"
          }
        ]
      },
      "then": {
        "level": "error",
        "category": "llm",
        "sub_category": "tokenizer",
        "outcome": "failure",
        "tags": [
          "llm",
          "tokenizer"
        ]
      }
    },
    {
      "rule_id": "llm-rag-timeout",
      "version": "1.0.0",
      "name": "RAG timeout detection",
      "description": "Detect RAG stage timeouts with high latency",
      "applies_to": [
        "llm"
      ],
      "when": {
        "all": [
          {
            "field": "pipeline_stage",
            "op": "in",
            "value": [
              "rag_retrieve",
              "rag_embed",
              "rag_rerank"
            ]
          },
          {
            "field": "outcome",
            "op": "eq",
            "value": "failure"
          },
          {
            "field": "@latency",
            "op": "gte",
            "value": 1000
          }
        ]
      },
      "then": {
        "level": "error",
        "category": "llm",
        "sub_category": "rag_timeout",
        "outcome": "timeout",
        "tags": [
          "llm",
          "rag"
        ]
      }
    },
    {
      "rule_id": "agentic-tool-dependency-error",
      "version": "1.0.0",
      "name": "Tool execution failures with dependency errors",
      "description": "Flag tool failures caused by missing dependencies",
      "applies_to": [
        "agentic"
      ],
      "when": {
        "all": [
          {
            "field": "step_kind",
            "op": "eq",
            "value": "step"
          },
          {
            "field": "status",
            "op": "eq",
            "value": "failed"
          },
          {
            "field": "error.message",
            "op": "regex",
            "value": "(?i)(modulenotfound|importerror|no module named)"
          }
        ]
      },
      "then": {
        "level": "error",
        "category": "agentic",
        "sub_category": "dependency",
        "outcome": "failure",
        "tags": [
          "agentic",
          "dependency"
        ]
      }
    },
    {
      "rule_id": "agentic-tool-slow",
      "version": "1.0.0",
      "name": "Long-running tool executions",
      "description": "Flag tools running longer than expected",
      "applies_to": [
        "agentic"
      ],
      "when": {
        "all": [
          {
            "field": "step_kind",
            "op": "eq",
            "value": "step"
          },
          {
            "field": "status",
            "op": "in",
            "value": [
              "success",
              "retry"
            ]
          },
          {
            "field": "duration_ms",
            "op": "gte",
            "value": 5000
          }
        ]
      },
      "then": {
        "level": "warn",
        "category": "agentic",
        "sub_category": "tool_call",
        "outcome": "success",
        "tags": [
          "agentic",
          "slow"
        ]
      }
    },
    {
      "rule_id": "cv-cuda-oom",
      "version": "1.0.0",
      "name": "CUDA out of memory errors",
      "description": "Critical GPU memory allocation failures",
      "applies_to": [
        "computer_vision"
      ],
      "when": {
        "all": [
          {
            "field": "outcome",
            "op": "eq",
            "value": "failure"
          },
          {
            "field": "meta.raw_message",
            "op": "contains",
            "value": "CUDA out of memory"
          }
        ]
      },
      "then": {
        "level": "critical",
        "category": "cv",
        "sub_category": "infrastructure",
        "outcome": "failure",
        "tags": [
          "cv",
          "cuda",
          "oom"
        ]
      }
    },
    {
      "rule_id": "cv-throughput-high",
      "version": "1.0.0",
      "name": "High image throughput",
      "description": "Extract image count with separators and flag if >= 3000",
      "applies_to": [
        "computer_vision"
      ],
      "when": {
        "all": [
          {
            "field": "meta.raw_message",
            "op": "extract_number",
            "pattern": "([0-9,]+)\\s+images",
            "compare": {
              "gte": 3000
            }
          }
        ]
      },
      "then": {
        "level": "info",
        "category": "cv",
        "sub_category": "metrics",
        "outcome": "success",
        "tags": [
          "cv",
          "throughput"
        ]
      }
    },
    {
      "rule_id": "cv-batch-slow",
      "version": "1.0.0",
      "name": "Slow batch inference (by seconds in message)",
      "description": "Extract seconds from raw message and flag if >= 60s",
      "applies_to": [
        "computer_vision"
      ],
      "when": {
        "all": [
          {
            "field": "phase",
            "op": "eq",
            "value": "inference"
          },
          {
            "field": "meta.raw_message",
            "op": "extract_ms",
            "pattern": "([0-9]+)\\s*s",
            "compare": {
              "gte": 60000
            }
          }
        ]
      },
      "then": {
        "level": "warn",
        "category": "cv",
        "sub_category": "inference",
        "outcome": "success",
        "tags": [
          "cv",
          "slow_batch"
        ]
      }
    }
  ]
}
