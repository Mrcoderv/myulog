{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmdenaAI/ULog/rules/rules.schema.json",
  "title": "ULog Classification Rules Schema v0.1",
  "description": "Schema for validating rules.json - deterministic rules with first-match-wins semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules_version", "rules"],
  "properties": {
    "rules_version": {
      "type": "string",
      "pattern": "^v\\d+(\\.\\d+){0,2}$",
      "description": "Semantic version of the ruleset (e.g., v0.1, v1.0.0)"
    },
    "aliases": {
      "type": "object",
      "description": "Optional field alias mapping for cross-schema rule logic. Keys prefixed with @ map to arrays of field paths.",
      "patternProperties": {
        "^@[a-zA-Z][a-zA-Z0-9_]*$": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "default_action": {
      "type": "object",
      "description": "Action applied when no rules match",
      "additionalProperties": false,
      "required": ["level", "category", "outcome"],
      "properties": {
        "level": {
          "enum": ["debug", "info", "warn", "error", "critical"],
          "description": "Severity level from controlled vocabulary"
        },
        "category": {
          "enum": ["core_api", "llm", "agentic", "cv"],
          "description": "Primary category from controlled vocabulary"
        },
        "sub_category": {
          "type": "string",
          "description": "Sub-category from controlled vocabulary (validated at runtime)"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "timeout",
            "cancelled",
            "running",
            "pending"
          ],
          "description": "Final disposition from controlled vocabulary"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "rules": {
      "type": "array",
      "description": "Array of classification rules evaluated in order (first-match-wins)",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "when", "then"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]+$",
          "minLength": 3,
          "maxLength": 50,
          "description": "Unique, stable identifier (e.g., api-5xx-critical, llm-rag-timeout)"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Rule version (semantic versioning)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable rule name",
          "minLength": 5,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of what this rule does",
          "maxLength": 500
        },
        "disabled": {
          "type": "boolean",
          "default": false,
          "description": "If true, rule is skipped during evaluation"
        },
        "applies_to": {
          "type": "array",
          "description": "Schema(s) this rule applies to; omit for global rules",
          "items": {
            "enum": ["core_api", "llm", "agentic", "computer_vision"]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "when": {
          "$ref": "#/$defs/condition",
          "description": "Condition tree that must evaluate to true for rule to fire"
        },
        "then": {
          "$ref": "#/$defs/action",
          "description": "Action to apply when rule fires"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Recursive condition node with logical operators or atomic comparisons",
      "oneOf": [
        { "required": ["all"] },
        { "required": ["any"] },
        { "required": ["not"] },
        { "required": ["field", "op"] },
        { "required": ["field_any", "op"] }
      ],
      "properties": {
        "all": {
          "type": "array",
          "description": "AND - all subconditions must evaluate to true",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        },
        "any": {
          "type": "array",
          "description": "OR - at least one subcondition must evaluate to true",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        },
        "not": {
          "description": "NOT - negate the result of the subcondition",
          "$ref": "#/$defs/condition"
        },
        "field": {
          "type": "string",
          "description": "Single field path (dot notation) or alias (@status, @latency)",
          "minLength": 1
        },
        "field_any": {
          "type": "array",
          "description": "Array of field paths with OR semantics - succeeds if ANY path satisfies operator",
          "items": { "type": "string" },
          "minItems": 1
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "nin",
            "exists",
            "regex",
            "contains",
            "starts_with",
            "ends_with",
            "extract_ms",
            "extract_number",
            "extract_percent"
          ],
          "description": "Comparison operator"
        },
        "value": {
          "description": "Value to compare against (type depends on operator)"
        },
        "pattern": {
          "type": "string",
          "description": "Regex capture pattern used with extractor ops"
        },
        "compare": { "$ref": "#/$defs/compare" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "description": "Classification action to apply when rule matches",
      "minProperties": 1,
      "properties": {
        "level": {
          "enum": ["debug", "info", "warn", "error", "critical"],
          "description": "Severity level from controlled vocabulary"
        },
        "category": {
          "enum": ["core_api", "llm", "agentic", "cv"],
          "description": "Primary category from controlled vocabulary"
        },
        "sub_category": {
          "type": "string",
          "description": "Sub-category from controlled vocabulary (see vocab/controlled_vocabulary.json)",
          "minLength": 1,
          "maxLength": 50
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "timeout",
            "cancelled",
            "running",
            "pending"
          ],
          "description": "Final disposition from controlled vocabulary"
        },
        "tags": {
          "type": "array",
          "description": "Array of string tags for filtering and metrics",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "description": "Numeric comparison applied to extracted value",
      "oneOf": [
        { "required": ["gt"] },
        { "required": ["gte"] },
        { "required": ["lt"] },
        { "required": ["lte"] },
        { "required": ["eq"] }
      ],
      "properties": {
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "eq": { "type": "number" }
      }
    }
  }
}
