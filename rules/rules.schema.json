{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmdenaAI/ULog/rules/rules.schema.json",
  "title": "ULog Classification Rules Schema v0.1",
  "description": "Schema for validating rules.json - deterministic rules with first-match-wins semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules_version", "rules"],
  "properties": {
    "rules_version": {
      "type": "string",
      "pattern": "^v\\d+(\\.\\d+){0,2}$",
      "description": "Semantic version of the ruleset (e.g., v0.1, v1.0.0)"
    },
    "aliases": {
      "type": "object",
      "description": "Optional field alias mapping for cross-schema rule logic. Keys prefixed with @ map to arrays of field paths.",
      "patternProperties": {
        "^@[a-zA-Z][a-zA-Z0-9_]*$": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "default_action": {
      "type": "object",
      "description": "Action applied when no rules match",
      "additionalProperties": false,
      "required": ["level", "category", "outcome"],
      "properties": {
        "level": {
          "enum": ["debug", "info", "warn", "error", "critical"]
        },
        "category": {
          "enum": ["core_api", "llm", "agentic", "cv"]
        },
        "sub_category": {
          "type": "string"
        },
        "outcome": {
          "enum": ["success", "failure", "timeout", "cancelled", "running", "pending"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "rules": {
      "type": "array",
      "description": "Array of classification rules evaluated in order (first-match-wins)",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "when", "then"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]+$",
          "minLength": 3,
          "maxLength": 50
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": { "type": "string", "minLength": 5, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "disabled": { "type": "boolean", "default": false },
        "applies_to": {
          "type": "array",
          "items": { "enum": ["core_api", "llm", "agentic", "computer_vision"] },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Schema filter; omit for global rules"
        },
        "when": { "$ref": "#/$defs/condition" },
        "then": { "$ref": "#/$defs/action" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["all"] },
        { "required": ["any"] },
        { "required": ["not"] },
        { "required": ["field", "op"] },
        { "required": ["field_any", "op"] }
      ],
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "field": { "type": "string", "minLength": 1 },
        "field_any": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "op": {
          "enum": [
            "eq","neq","gt","gte","lt","lte","in","nin","exists",
            "regex","contains","starts_with","ends_with",
            "extract_ms","extract_number","extract_percent"
          ]
        },
        "value": {},
        "pattern": { "type": "string" },
        "compare": { "$ref": "#/$defs/compare" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "level": { "enum": ["debug", "info", "warn", "error", "critical"] },
        "category": { "enum": ["core_api", "llm", "agentic", "cv"] },
        "sub_category": { "type": "string", "minLength": 1, "maxLength": 50 },
        "outcome": { "enum": ["success","failure","timeout","cancelled","running","pending"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["gt"] },
        { "required": ["gte"] },
        { "required": ["lt"] },
        { "required": ["lte"] },
        { "required": ["eq"] }
      ],
      "properties": {
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "eq": { "type": "number" }
      }
    }
  }
}
