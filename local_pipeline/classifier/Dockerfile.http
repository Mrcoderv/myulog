FROM python:3.12-slim

# curl install for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Flask for HTTP service
# TODO (ticket 2.2): Replace with requirements.txt from poetry export
RUN pip install --no-cache-dir flask==3.0.0 jsonschema==4.20.0

COPY http_app.py /app/http_app.py

ENV PYTHONUNBUFFERED=1
ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["python", "/app/http_app.py"]
