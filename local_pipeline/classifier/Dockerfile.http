FROM python:3.12-slim

# curl needed for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Runtime deps (keep lean; pin moderately)
RUN python -m pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      fastapi==0.115.* \
      uvicorn==0.32.* \
      jsonschema==4.23.* \
      referencing==0.35.*

# App code + artifacts
COPY pyproject.toml poetry.lock* /app/
COPY src /app/src
COPY rules /app/rules
COPY schemas /app/schemas
COPY vocab /app/vocab

# Default env; can be overridden by .env / compose
ENV RULES_PATH=/app/rules/rules.json \
    ULOG_RULES_PATH=/app/rules/rules.json \
    SCHEMAS_DIR=/app/schemas \
    ULOG_SCHEMAS_DIR=/app/schemas \
    VOCAB_PATH=/app/vocab/controlled_vocabulary.json \
    ULOG_VOCAB_PATH=/app/vocab/controlled_vocabulary.json \
    PYTHONPATH=/app/src \
    PORT=8080

EXPOSE 8080

# Run the FastAPI app provided by Ticket 2.2
CMD ["sh", "-c", "uvicorn ulog.classifier.http:app --host 0.0.0.0 --port ${PORT}"]
