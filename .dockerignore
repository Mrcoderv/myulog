# Git
.git/
.github/
.gitignore

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build outputs (don't include in build context)
dist/
build/
*.egg-info/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/
.tox/
.nox/
nosetests.xml
coverage.xml
tests/reports/
tests/perf_artifacts/

# Type checking
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.ruff_cache/

# Environment & Secrets
.env
.env.*
*.pem
*.key

# Logs
*.log
logs/

# Documentation
docs/_build/
docs/coverage.svg
site/

# Temporary files
*.tmp
*.bak
.cache/

# Local pipeline data
local_pipeline/in/*
local_pipeline/out/*

# Synthetic data
data/synthetic/*.jsonl
data/synthetic/raw/*.jsonl

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Keep test examples (needed for validation)
!tests/examples/