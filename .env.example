# Log level for local CLI/services. One of: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Local HTTP Service PORT
PORT=8080

# Mounted input directory in docker-compose (see local_pipeline/docker-compose.yml)
IN_DIR=/in

# Mounted output directory for artifacts/results
OUT_DIR=/out

# Local image tag used by docker-compose service "classifier"
CLASSIFIER_IMAGE=ulog-classifier:local

# Python version used in CI and local tools
PYTHON_VERSION=3.12

# Optional: override vocabulary path used by the normalizer
# ULOG_VOCAB_PATH=./vocab/controlled_vocabulary.json
